rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for treasury snapshot (Bounty Board / Donation Portal)
    match /treasury/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }
    
    // No public read on orders (privacy)
    match /solcot_orders/{doc} {
      allow read, write: if false; // Functions only
    }
    
    // Lobster queue
    match /lobster_lease_queue/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }
    
    // Legacy / Other Hearthlands collections
    match /agent_profiles/{doc} {
      allow read: if true; // Public read so agents can verify scores
      allow write: if false; // Functions only
    }

    // Phase A+B: human Privy ID ↔ Solana pubkey (server-written only)
    match /wallet_identities/{doc} {
      allow read, write: if false;
    }
    
    match /bounty_claims/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }
    
    match /lodge_quests/{doc} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    match /lodge_members/{doc} {
      allow read: if true;
      allow write: if false; // Steward sync only
    }

    match /lodge_rooms/{doc} {
      allow read: if true;
      allow write: if false; // Steward sync only
    }

    match /lodge_meta/{doc} {
      allow read: if true;
      allow write: if false; // Steward sync only
    }

    match /lodge_claims/{doc} {
      allow read: if resource.data.status == 'approved';
      allow write: if false; // Steward-only review path
    }
    
    // World state — Bellows + Forge (read-only from clients)
    match /three_forge/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Emergent Embodiment Ledger mirror (server-written only)
    match /embodiment_ledger/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /welcome_grants/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /treasury_intents/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /moltbook_recruitment_log/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Lodge presence — users can write only their own presence
    match /lodge_presence/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /lodge_activity/{doc} {
      allow read, write: if false; // Reserved branch
    }

    // User data — users can only read/write their own
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isProjectRoomMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/project_rooms/$(roomId)/members/$(request.auth.uid));
    }

    function projectRoomRole(roomId) {
      return get(/databases/$(database)/documents/project_rooms/$(roomId)/members/$(request.auth.uid)).data.role;
    }

    function canManageProjectRoom(roomId) {
      return isProjectRoomMember(roomId) && projectRoomRole(roomId) == 'owner';
    }

    function canEditProjectRoom(roomId) {
      return isProjectRoomMember(roomId) && projectRoomRole(roomId) in ['owner', 'editor'];
    }

    function canReviewProjectRoom(roomId) {
      return isProjectRoomMember(roomId) && projectRoomRole(roomId) in ['owner', 'editor', 'reviewer'];
    }

    function inviteDoc(token) {
      return get(/databases/$(database)/documents/project_invites/$(token));
    }

    function validProjectInvite(roomId, token) {
      return exists(/databases/$(database)/documents/project_invites/$(token)) &&
        inviteDoc(token).data.project_id == roomId &&
        inviteDoc(token).data.status == 'pending' &&
        inviteDoc(token).data.role in ['editor', 'reviewer', 'viewer'] &&
        inviteDoc(token).data.expires_at_ms > request.time.toMillis();
    }

    function validCommentParent(roomId) {
      return !('parent_comment_id' in request.resource.data) ||
        request.resource.data.parent_comment_id == null ||
        exists(/databases/$(database)/documents/project_rooms/$(roomId)/comments/$(request.resource.data.parent_comment_id));
    }

    function validMemberShape() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'display_name',
        'role',
        'joined_at',
        'invite_token',
        'moltbook_handle',
        'moltbook_profile_url',
        'honor_tier',
        'skill_tags'
      ]) &&
      request.resource.data.uid is string &&
      request.resource.data.role in ['owner', 'editor', 'reviewer', 'viewer'];
    }

    function safeSelfProfileUpdate(memberId) {
      return signedIn() &&
        memberId == request.auth.uid &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'display_name',
          'moltbook_handle',
          'moltbook_profile_url',
          'honor_tier',
          'skill_tags'
        ]);
    }

    function validPresenceShape(memberId) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'display_name',
        'status',
        'last_active_ms',
        'updated_at'
      ]) &&
      memberId == request.auth.uid &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.status in ['online', 'offline'] &&
      request.resource.data.last_active_ms is number;
    }

    match /project_rooms/{roomId} {
      allow read: if isProjectRoomMember(roomId);
      allow create: if signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.auth.uid in request.resource.data.member_uids;
      allow update: if canEditProjectRoom(roomId);
      allow delete: if canManageProjectRoom(roomId);

      match /members/{memberId} {
        allow read: if isProjectRoomMember(roomId);
        allow create: if validMemberShape() && (
          canManageProjectRoom(roomId) ||
          (
            signedIn() &&
            memberId == request.auth.uid &&
            get(/databases/$(database)/documents/project_rooms/$(roomId)).data.owner_uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'owner'
          ) ||
          (
            signedIn() &&
            memberId == request.auth.uid &&
            validProjectInvite(roomId, request.resource.data.invite_token) &&
            request.resource.data.role == inviteDoc(request.resource.data.invite_token).data.role &&
            request.resource.data.uid == request.auth.uid
          )
        );
        allow update: if (validMemberShape() && canManageProjectRoom(roomId)) || safeSelfProfileUpdate(memberId);
        allow delete: if canManageProjectRoom(roomId);
      }

      match /invites/{inviteId} {
        allow read: if canManageProjectRoom(roomId);
        allow create, delete: if canManageProjectRoom(roomId);
        allow update: if canManageProjectRoom(roomId) ||
          (
            signedIn() &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.accepted_by == request.auth.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.project_id == roomId
          );
      }

      match /comments/{commentId} {
        allow read: if isProjectRoomMember(roomId);
        allow create: if canReviewProjectRoom(roomId) &&
          request.resource.data.author_uid == request.auth.uid &&
          request.resource.data.project_id == roomId &&
          validCommentParent(roomId);
        allow update: if canReviewProjectRoom(roomId);
        allow delete: if canManageProjectRoom(roomId);
      }

      match /events/{eventId} {
        allow read: if isProjectRoomMember(roomId);
        allow create: if canReviewProjectRoom(roomId);
        allow update, delete: if false;
      }

      match /presence/{memberId} {
        allow read: if isProjectRoomMember(roomId);
        allow create, update: if isProjectRoomMember(roomId) && validPresenceShape(memberId);
        allow delete: if canManageProjectRoom(roomId) || (signedIn() && memberId == request.auth.uid);
      }
    }

    match /project_invites/{token} {
      allow read: if true;
      allow create: if signedIn() && canManageProjectRoom(request.resource.data.project_id);
      allow update: if canManageProjectRoom(resource.data.project_id) ||
        (
          signedIn() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.accepted_by == request.auth.uid &&
          request.resource.data.project_id == resource.data.project_id &&
          request.resource.data.role == resource.data.role
        );
      allow delete: if false;
    }

    match /published_handoffs/{token} {
      allow read: if resource.data.revoked != true;
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.published_by.uid == request.auth.uid;
      allow delete: if false;
    }

    match /resonance_sessions/{doc} {
      allow read: if true; // or conditionally check if completed/participant, keeping it true for now as per common practice for public artifacts unless fully gated
      allow write: if false; // Functions only
    }

    // Governance engine proposals
    match /proposals/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

