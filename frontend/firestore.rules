rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for treasury snapshot (Bounty Board / Donation Portal)
    match /treasury/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }
    
    // No public read on orders (privacy)
    match /solcot_orders/{doc} {
      allow read, write: if false; // Functions only
    }
    
    // Lobster queue
    match /lobster_lease_queue/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }
    
    // Legacy / Other Hearthlands collections
    match /agent_profiles/{doc} {
      allow read: if true; // Public read so agents can verify scores
      allow write: if false; // Functions only
    }

    // Phase A+B: human Privy ID ↔ Solana pubkey (server-written only)
    match /wallet_identities/{doc} {
      allow read, write: if false;
    }
    
    match /bounty_claims/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }
    
    match /lodge_quests/{doc} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    match /lodge_members/{doc} {
      allow read: if true;
      allow write: if false; // Steward sync only
    }

    match /lodge_rooms/{doc} {
      allow read: if true;
      allow write: if false; // Steward sync only
    }

    match /lodge_meta/{doc} {
      allow read: if true;
      allow write: if false; // Steward sync only
    }

    match /lodge_claims/{doc} {
      allow read: if resource.data.status == 'approved';
      allow write: if false; // Steward-only review path
    }
    
    // World state — Bellows + Forge (read-only from clients)
    match /three_forge/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Emergent Embodiment Ledger mirror (server-written only)
    match /embodiment_ledger/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /welcome_grants/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /treasury_intents/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /moltbook_recruitment_log/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Lodge presence — users can write only their own presence
    match /lodge_presence/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /lodge_activity/{doc} {
      allow read, write: if false; // Reserved branch
    }

    // User data — users can only read/write their own
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isProjectRoomMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/project_rooms/$(roomId)/members/$(request.auth.uid));
    }

    function projectRoomRole(roomId) {
      return get(/databases/$(database)/documents/project_rooms/$(roomId)/members/$(request.auth.uid)).data.role;
    }

    function canManageProjectRoom(roomId) {
      return isProjectRoomMember(roomId) && projectRoomRole(roomId) == 'owner';
    }

    function canEditProjectRoom(roomId) {
      return isProjectRoomMember(roomId) && projectRoomRole(roomId) in ['owner', 'editor'];
    }

    function canReviewProjectRoom(roomId) {
      return isProjectRoomMember(roomId) && projectRoomRole(roomId) in ['owner', 'editor', 'reviewer'];
    }

    match /project_rooms/{roomId} {
      allow read: if isProjectRoomMember(roomId);
      allow create: if signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.auth.uid in request.resource.data.member_uids;
      allow update: if canEditProjectRoom(roomId);
      allow delete: if canManageProjectRoom(roomId);

      match /members/{memberId} {
        allow read: if isProjectRoomMember(roomId);
        allow create, update, delete: if canManageProjectRoom(roomId) ||
          (
            signedIn() &&
            memberId == request.auth.uid &&
            get(/databases/$(database)/documents/project_rooms/$(roomId)).data.owner_uid == request.auth.uid &&
            request.resource.data.role == 'owner'
          ) ||
          (signedIn() && memberId == request.auth.uid && request.resource.data.role in ['reviewer', 'viewer']);
      }

      match /invites/{inviteId} {
        allow read: if canManageProjectRoom(roomId);
        allow create, update, delete: if canManageProjectRoom(roomId);
      }

      match /comments/{commentId} {
        allow read: if isProjectRoomMember(roomId);
        allow create: if canReviewProjectRoom(roomId) &&
          request.resource.data.author_uid == request.auth.uid &&
          request.resource.data.project_id == roomId;
        allow update: if canReviewProjectRoom(roomId);
        allow delete: if canManageProjectRoom(roomId);
      }

      match /events/{eventId} {
        allow read: if isProjectRoomMember(roomId);
        allow create: if canReviewProjectRoom(roomId);
        allow update, delete: if false;
      }
    }

    match /published_handoffs/{token} {
      allow read: if resource.data.revoked != true;
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.published_by.uid == request.auth.uid;
      allow delete: if false;
    }

    match /resonance_sessions/{doc} {
      allow read: if true; // or conditionally check if completed/participant, keeping it true for now as per common practice for public artifacts unless fully gated
      allow write: if false; // Functions only
    }

    // Governance engine proposals
    match /proposals/{doc} {
      allow read: if true;
      allow write: if false; // Functions only
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

