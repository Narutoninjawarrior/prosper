# Copy to .env.local and fill with your Firebase web app config (Console → Project settings).
# Never commit .env or .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Steward-only (Node at repo root, not Vite): run `npm run sync:firestore` with
# GOOGLE_APPLICATION_CREDENTIALS pointing at a service account JSON (Firestore write).
