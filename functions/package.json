{
  "name": "functions",
  "scripts": {
    "sync-catalog": "node -e \"require('fs').copyFileSync(require('path').join(__dirname,'..','frontend','public','workshop_parts.json'), require('path').join(__dirname,'data','workshop_parts.json'))\"",
    "build": "npm run sync-catalog && tsc",
    "test": "npm run build && node --test lib/src/test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "@types/node": "^25.9.1",
    "bs58": "^5.0.0",
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1",
    "stripe": "^22.2.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "typescript": "^4.9.0"
  },
  "private": true
}
